{
  "compilerOptions": {
    "target": "ES6", // 컴파일된 JavaScript 버전
    "module": "CommonJS", // Node.js 호환 모듈 시스템
    "outDir": "./dist", // 컴파일된 파일 저장 위치
    "rootDir": "./src", // 소스 파일 위치
    "strict": true, // 엄격한 타입 검사
    "esModuleInterop": true // CommonJS와 ES6 모듈 간 호환성
  },
  "include": [
    "src"
  ], // 컴파일할 파일 포함
  "exclude": [
    "node_modules"
  ] // 제외할 파일
}